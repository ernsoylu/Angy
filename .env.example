# Angy — local development defaults. Copy to .env.local and fill in secrets.
# Canonical documentation for every variable: docs/env.md

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/angy_dev

# Redis (Y.Doc hot cache instance must run noeviction)
REDIS_URL=redis://localhost:6379

# Meilisearch (master key is server-side only; clients get tenant tokens)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=angy-docs
S3_REGION=us-east-1

# OIDC (Keycloak/Authentik)
OIDC_ISSUER_URL=http://localhost:8080/realms/angy
OIDC_CLIENT_ID=angy-web
OIDC_CLIENT_SECRET=changeme

# Signs short-lived realtime connect + media access tokens (ADR 0007/0008).
# NOT user auth (that's OIDC + Redis sessions). Random, >= 32 chars.
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Public endpoints
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3002
