# Angy — local development defaults. Copy to .env.local and fill in secrets.
# Canonical documentation for every variable: docs/env.md

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/angy_dev

# Redis (Y.Doc hot cache instance must run noeviction)
REDIS_URL=redis://localhost:6379

# Meilisearch (master key is server-side only; clients get tenant tokens)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=angy-docs
S3_REGION=us-east-1
# Browser-facing storage origin; defaults to S3_ENDPOINT. Only differs when
# object storage is reachable at two addresses (e.g. a tunnelled deployment).
# S3_PUBLIC_ENDPOINT=https://media.example.com

# OIDC — Authentik is the workspace identity provider (ADR 0011).
# The issuer is per-application: /application/o/<app-slug>/
OIDC_ISSUER_URL=http://localhost:9010/application/o/angy/
OIDC_CLIENT_ID=angy-web
OIDC_CLIENT_SECRET=changeme

# Signs short-lived realtime connect + media access tokens (ADR 0007/0008).
# NOT user auth (that's OIDC + Redis sessions). Random, >= 32 chars.
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Public endpoints
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3002
# The API's origin as the browser sees it. Defaults to its own listen address,
# which is correct for local dev; behind a proxy or tunnel it must be set, or
# the OIDC redirect_uri points somewhere that does not exist.
# PUBLIC_API_URL=https://api.example.com
# Domain for the session cookie. Leave unset locally — web and api are both
# `localhost`, so a host-only cookie is already shared. Behind a proxy they are
# different hosts and the cookie must be scoped to cover both.
# SESSION_COOKIE_DOMAIN=example.com
