# Build from the repo root: infra/docker/build.sh api
#
# prisma generate --sql introspects query types against a live database, so
# the build needs DATABASE_URL reachable from the build container (local dev:
# host.docker.internal via --network host; CI: a service container).
FROM node:24-slim AS build
RUN npm install -g pnpm@10.34.5
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
RUN pnpm build:packages && pnpm --filter @angy/api build
RUN infra/docker/prune.sh api

# Runtime carries only the pruned tree: this app's dist, the three workspace
# packages, and production dependencies (see infra/docker/prune.sh).
FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /deploy /app

# Drop root: nothing here needs it, and a container escape should not
# start from uid 0.
USER node

EXPOSE 3001
CMD ["node", "dist/main.js"]
