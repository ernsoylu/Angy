# Build from the repo root: infra/docker/build.sh realtime
FROM node:24-slim AS build
RUN npm install -g --ignore-scripts pnpm@10.34.5
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
RUN pnpm build:packages && pnpm --filter @angy/realtime build
RUN infra/docker/prune.sh realtime

FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /deploy /app

# Drop root: nothing here needs it, and a container escape should not
# start from uid 0.
USER node

EXPOSE 3002
CMD ["node", "dist/main.js"]
