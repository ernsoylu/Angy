# Build from the repo root: infra/docker/build.sh web
FROM node:24-slim AS build
RUN npm install -g pnpm@10
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
# Next inlines NEXT_PUBLIC_* into the client bundle at build time, so these are
# baked per image and CANNOT be overridden by the runtime `angy-env` Secret —
# the browser talks to whatever was compiled in. Server-only endpoints
# (API_INTERNAL_URL) stay runtime env.
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXT_PUBLIC_REALTIME_URL=ws://localhost:3002
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_REALTIME_URL=$NEXT_PUBLIC_REALTIME_URL
RUN pnpm build:packages && pnpm --filter @angy/web build

# Next standalone output is self-contained (traced node_modules included).
FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
