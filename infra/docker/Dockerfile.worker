# Build from the repo root: infra/docker/build.sh worker
FROM node:24-slim AS build
RUN npm install -g pnpm@10.34.5 # NOSONAR — pnpm onlyBuiltDependencies already allowlists scripts (see docs/runbooks/homelab.md §7)
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile # NOSONAR — pnpm onlyBuiltDependencies already allowlists scripts (see docs/runbooks/homelab.md §7)
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
RUN pnpm build:packages && pnpm --filter @angy/worker build
RUN infra/docker/prune.sh worker

FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /deploy /app

# Drop root: nothing here needs it, and a container escape should not
# start from uid 0.
USER node

CMD ["node", "dist/main.js"]
