// Angy V1 schema — follows docs/schema.md table inventory.
// Hard rules (CLAUDE.md): no Yjs blobs in Postgres (only ydoc_s3_key + small
// state vector), no block tables, closure table over pages only.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermLevel {
  VIEW
  EDIT
  FULL
  ADMIN

  @@map("perm_level")
}

enum SpaceVisibility {
  PUBLIC
  PRIVATE

  @@map("space_visibility")
}

/// What kind of actionable node a `block_index` row projects. Only the kinds
/// something actually writes belong here — it mirrors `RefKind` in
/// @angy/blocks exactly, so a drift between them is a compile error rather
/// than a silently unindexed node type. Mentions, tasks and macros each add a
/// value when their extractor lands.
enum BlockRefKind {
  PAGE_LINK
  MENTION
  TASK

  @@map("block_ref_kind")
}

model Space {
  id               BigInt          @id @default(autoincrement())
  key              String          @unique
  name             String
  description      String?
  visibility       SpaceVisibility @default(PUBLIC)
  defaultPermLevel PermLevel       @default(VIEW) @map("default_perm_level")
  createdAt        DateTime        @default(now()) @map("created_at")
  /// 30-day soft delete, mirroring page trash. Its pages keep their own
  /// deleted_at untouched, so restoring the space restores exactly what was
  /// live when it was trashed.
  deletedAt        DateTime?       @map("deleted_at")
  deletedBy        BigInt?         @map("deleted_by")

  members    SpaceMember[]
  pages      Page[]
  templates  PageTemplate[]
  properties PageProperty[]

  @@map("space")
}

/// Local mirror of OIDC identities. Dense bigint ids are required by the
/// permission-bitmap cache (ADR 0004: bit offset = user id).
model AppUser {
  id            BigInt    @id @default(autoincrement())
  oidcSubject   String    @unique @map("oidc_subject")
  email         String    @unique
  displayName   String    @map("display_name")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  memberships   SpaceMember[]
  permissions   PagePermission[]
  visits        PageVisit[]
  stars         PageStar[]
  mentions      BlockIndex[]
  notifications Notification[]
  comments      Comment[]

  @@map("app_user")
}

model SpaceMember {
  spaceId   BigInt    @map("space_id")
  userId    BigInt    @map("user_id")
  permLevel PermLevel @default(VIEW) @map("perm_level")
  addedAt   DateTime  @default(now()) @map("added_at")

  space Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@map("space_member")
}

/// The primitive (ADR 0001). One row per page; blocks live in document_json
/// and the Y.Doc in S3 — never in relational rows.
model Page {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId             BigInt    @map("space_id")
  parentId            String?   @map("parent_id") @db.Uuid
  title               String
  slug                String
  /// Place among siblings — a fractional index (`orderKeyBetween` in
  /// @angy/shared), not a position. Reordering one page updates one row and
  /// never renumbers the rest, and two people inserting at the same slot
  /// produce the same key rather than overwriting each other; every ordered
  /// query therefore sorts by `(ord, id)` so the tie breaks identically for
  /// everyone. The column is `COLLATE "C"` — see the migration for why the
  /// database's own collation cannot be trusted with these keys.
  ord                 String
  ydocS3Key           String?   @map("ydoc_s3_key")
  ydocStateVector     Bytes?    @map("ydoc_state_vector")
  documentJson        Json?     @map("document_json")
  renderedHtml        String?   @map("rendered_html")
  textExtract         String?   @map("text_extract")
  projectionUpdatedAt DateTime? @map("projection_updated_at")
  createdBy           BigInt    @map("created_by")
  updatedBy           BigInt?   @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  space         Space            @relation(fields: [spaceId], references: [id])
  parent        Page?            @relation("PageTree", fields: [parentId], references: [id])
  children      Page[]           @relation("PageTree")
  ancestors     PageAncestor[]   @relation("Descendant")
  descendants   PageAncestor[]   @relation("Ancestor")
  permissions   PagePermission[]
  revisions     PageRevision[]
  attachments   Attachment[]
  visits        PageVisit[]
  stars         PageStar[]
  tags          PageTag[]
  notifications Notification[]
  refs          BlockIndex[]     @relation("RefSource")
  referencedBy  BlockIndex[]     @relation("RefTargetPage")
  commentThreads CommentThread[]
  propertyValues PagePropertyValue[]
  database       PageDatabase?

  @@unique([spaceId, slug])
  @@index([spaceId])
  @@index([parentId])
  /// Sibling groups are read whole and in order: children by parent, roots by
  /// space (where parent_id is null and cannot serve as the group key).
  @@index([parentId, ord])
  @@index([spaceId, ord])
  @@map("page")
}

/// Per-user reading history behind the sidebar's Recent list. One row per
/// (user, page) — the reader render only writes through a Redis throttle, so a
/// reload storm costs one row update, not one per request.
model PageVisit {
  userId    BigInt   @map("user_id")
  pageId    String   @map("page_id") @db.Uuid
  visitedAt DateTime @default(now()) @map("visited_at")
  visits    Int      @default(1)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([userId, visitedAt(sort: Desc)])
  @@map("page_visit")
}

/// Freeform labels, workspace-wide: the name is the identity and is shared
/// across every space. Names are normalised before they get here
/// (`normalizeTag` in @angy/shared), so the unique index is the real
/// deduplication — admins rename and merge whatever still drifts.
model Tag {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  createdBy BigInt   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  pages PageTag[]

  @@map("tag")
}

model PageTag {
  pageId  String   @map("page_id") @db.Uuid
  tagId   BigInt   @map("tag_id")
  addedBy BigInt   @map("added_by")
  addedAt DateTime @default(now()) @map("added_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pageId, tagId])
  @@index([tagId])
  @@map("page_tag")
}

/// Per-user bookmarks behind the sidebar's Starred list.
model PageStar {
  userId    BigInt   @map("user_id")
  pageId    String   @map("page_id") @db.Uuid
  starredAt DateTime @default(now()) @map("starred_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([userId, starredAt(sort: Desc)])
  @@map("page_star")
}

/// Projection of the *actionable* nodes inside pages (ADR 0001, V2 H1) — what
/// a document references, made queryable: backlinks, mentions, tasks, macros.
///
/// This is **not** the block table hard rule 2 forbids. It is derived,
/// disposable and rebuilt from the Y.Doc by the same projection job that
/// writes document_json/rendered_html; the editor never writes it, nothing
/// reads it as a source of truth, and dropping the table costs a reprojection.
/// Granularity is one row per actionable node, never one per block: rows scale
/// with links and mentions, not with document size.
model BlockIndex {
  pageId       String       @map("page_id") @db.Uuid
  /// Document order of the node within its page. Rows are replaced wholesale
  /// per page on every rebuild, so this is stable identity, not a cursor.
  ord          Int
  kind         BlockRefKind
  targetPageId String?      @map("target_page_id") @db.Uuid
  targetUserId BigInt?      @map("target_user_id")
  /// Per-occurrence body. For a page link: `{ label }`, the title as rendered
  /// into rendered_html — the stale-title refresh compares against it.
  payload      Json?

  page       Page     @relation("RefSource", fields: [pageId], references: [id], onDelete: Cascade)
  targetPage Page?    @relation("RefTargetPage", fields: [targetPageId], references: [id], onDelete: Cascade)
  targetUser AppUser? @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  @@id([pageId, ord])
  @@index([targetPageId])
  @@index([targetUserId])
  @@map("block_index")
}

/// A reusable page skeleton (V2 H2) — a snapshot of a page's `document_json`,
/// applied by copying it into a new page's initial document.
///
/// Deliberately **not** a Page carrying an `is_template` flag. That would have
/// come with editing, history and permissions for free, but a template that is
/// a page has to be excluded from the tree, search, backlinks, trash, Recent,
/// Starred and every future listing — and missing one leaks a template into a
/// surface where it reads as real content. A separate table cannot leak.
///
/// The cost of that choice is that a template is edited by re-saving a page
/// over it, not by opening the template itself.
model PageTemplate {
  id           BigInt   @id @default(autoincrement())
  spaceId      BigInt   @map("space_id")
  name         String
  description  String?
  /// The page body this template stamps out. Applied through the same
  /// `createPage(documentJson)` → `initYdoc` path a normal page takes, so
  /// templates add no second way for a document to come into existence.
  documentJson Json     @map("document_json")
  createdBy    BigInt   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, name])
  @@index([spaceId])
  @@map("page_template")
}

/// What a notification is about. Only kinds something actually raises belong
/// here, mirroring `block_index`'s rule.
enum NotificationKind {
  MENTION
  COMMENT

  @@map("notification_kind")
}

/// Per-user inbox (V2 H3) — raised by the projection worker, read by the app.
///
/// One row per (user, page, kind), not one per mention: being named three
/// times in one document is one thing to look at. The unique key is what makes
/// the worker's insert idempotent, which matters because a projection rebuild
/// is re-run freely and must not manufacture a new notification each time.
model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id")
  kind      NotificationKind
  pageId    String           @map("page_id") @db.Uuid
  /// Who caused it — the page's last editor at the time it was raised.
  actorId   BigInt?          @map("actor_id")
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, pageId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notification")
}

/// What a page property holds (V2 H5.3, ADR 0013). Deliberately few: each one
/// is a column on `page_property_value`, a filter operator set and a cell
/// renderer, so a type nobody asked for is three things to maintain.
enum PropertyType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
  USER

  @@map("property_type")
}

/// A property definition, scoped to a space (V2 H5.3, ADR 0013).
///
/// This is the "small and genuinely relational" half of databases-in-pages:
/// properties are page *metadata*, not blocks, so hard rule 2 is untouched.
/// Definitions live at the space level rather than per database so that two
/// views can agree on what "Status" means — the alternative is a Status column
/// per page and no way to query across them.
model PageProperty {
  id        BigInt       @id @default(autoincrement())
  spaceId   BigInt       @map("space_id")
  name      String
  type      PropertyType
  /// Choices for SELECT, in display order. Empty for every other type.
  options   String[]     @default([])
  /// Place in the space's property list — the same fractional key pages use.
  ord       String
  createdBy BigInt       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")

  space  Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  values PagePropertyValue[]

  @@unique([spaceId, name])
  @@index([spaceId, ord])
  @@map("page_property")
}

/// One page's value for one property.
///
/// Typed columns rather than a JSON blob, because the whole point of the
/// property model is that a view can *filter and sort* on it: `WHERE
/// text_value ILIKE …` is an index away from being fast, while
/// `value->>'text'` is a scan and a cast. Exactly one column is populated —
/// which one is decided by the property's type.
model PagePropertyValue {
  pageId       String    @map("page_id") @db.Uuid
  propertyId   BigInt    @map("property_id")
  textValue    String?   @map("text_value")
  numberValue  Float?    @map("number_value")
  dateValue    DateTime? @map("date_value")
  checkboxValue Boolean? @map("checkbox_value")
  userValue    BigInt?   @map("user_value")
  updatedBy    BigInt    @map("updated_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  page     Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  property PageProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([pageId, propertyId])
  @@index([propertyId, textValue])
  @@index([propertyId, numberValue])
  @@index([propertyId, dateValue])
  @@map("page_property_value")
}

/// A page that presents its children as a table (V2 H5.3, ADR 0013).
///
/// A database is a *view*, not a container: the rows are the page's children,
/// which are Pages with their own permissions, history, search and trash. This
/// row holds only how to present them — which properties are columns, what to
/// filter by, what to sort by.
///
/// The first slice is read-only by design (ADR 0013). Editing cells in the
/// table would make a projection an edit target, which is the mistake hard
/// rule 2 exists to prevent; values are edited on the row's own page.
model PageDatabase {
  pageId    String   @id @map("page_id") @db.Uuid
  /// Property ids in column order. An array rather than a join table: column
  /// order is a property *of the view*, and a join table would need its own
  /// ordering column to say the same thing.
  columns   BigInt[] @default([])
  /// `[{ propertyId, op, value }]` — validated by zod on write, translated to
  /// SQL on read. Never interpolated.
  filters   Json     @default("[]")
  /// `[{ propertyId, direction }]`, applied in order.
  sorts     Json     @default("[]")
  createdBy BigInt   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_database")
}

/// A comment conversation anchored to a range of text (V2 H5.2, ADR 0014).
///
/// The anchor is **not** here: it is a `comment` mark carrying this row's id,
/// inside the page's Y.Doc, so the CRDT moves it with the text it covers. What
/// lives relationally is everything a document should not carry — who, when,
/// resolved, and the replies — because a reply must not be an edit.
///
/// A thread whose mark has been deleted is `orphanedAt`, flagged by the
/// projection worker (which already walks the document) rather than deleted:
/// the sentence is gone, the conversation about it usually still matters.
model CommentThread {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId     String    @map("page_id") @db.Uuid
  /// The text the mark covered when the thread was opened. A label for the
  /// rail, never the anchor — the document is the anchor.
  anchorText String    @map("anchor_text")
  createdBy  BigInt    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedBy BigInt?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  orphanedAt DateTime? @map("orphaned_at")

  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([pageId, resolvedAt])
  @@map("comment_thread")
}

/// One remark in a thread — the first is the thread's opening comment, the
/// rest are replies. Plain text, deliberately: a two-line remark does not need
/// a CRDT, an S3 object and a revision history (ADR 0014).
model Comment {
  id        BigInt    @id @default(autoincrement())
  threadId  String    @map("thread_id") @db.Uuid
  authorId  BigInt    @map("author_id")
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")

  thread CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author AppUser       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("comment")
}

/// Closure table over pages only — never blocks (hard rule 2).
model PageAncestor {
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  ancestor   Page @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant Page @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("page_ancestor")
}

/// Additive page-level grants above the space baseline. Notion rule: grants
/// only widen access, never reduce it.
model PagePermission {
  pageId    String    @map("page_id") @db.Uuid
  userId    BigInt    @map("user_id")
  permLevel PermLevel @map("perm_level")
  grantedBy BigInt    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")

  page Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pageId, userId])
  @@map("page_permission")
}

/// Revision pointers — blobs are full Y.Doc states in S3 (ADR 0006).
model PageRevision {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId        String   @map("page_id") @db.Uuid
  version       Int
  revisionS3Key String   @map("revision_s3_key")
  stateVector   Bytes?   @map("state_vector")
  label         String?
  sizeBytes     BigInt?  @map("size_bytes")
  createdBy     BigInt   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, createdAt])
  @@map("page_revision")
}

model Attachment {
  id             BigInt    @id @default(autoincrement())
  pageId         String?   @map("page_id") @db.Uuid
  fileName       String    @map("file_name")
  sha256         String
  mimeType       String    @map("mime_type")
  sizeBytes      BigInt    @map("size_bytes")
  width          Int?
  height         Int?
  s3Key          String    @map("s3_key")
  thumbnailS3Key String?   @map("thumbnail_s3_key")
  uploadedBy     BigInt    @map("uploaded_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  page Page? @relation(fields: [pageId], references: [id])

  @@index([sha256])
  @@map("attachment")
}
